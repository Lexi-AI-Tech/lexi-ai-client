+
+.transcript-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 12px;
+}
+
+.transcript-header h4 {
+  font-size: 14px;
+  font-weight: 600;
+  color: #111827;
+  margin: 0;
+}
+
+.transcript-actions {
+  display: flex;
+  gap: 8px;
+}
+
+.transcript-text {
+  margin-bottom: 12px;
