+++ b/src/styles/global.css
@@ -0,0 +1,807 @@
+/* Shared UI: settings, status, buttons, transcripts, modals */
+.settings-page {
+  width: 100%;
+  max-width: 600px;
+  margin: 0 auto;
+}
+
+.header {
+  margin-bottom: 24px;
+}
+
+.app-title {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  margin-bottom: 8px;
+}
+
+.logo {
+  font-size: 24px;
+  animation: pulse 2s infinite;
+}
+
+.title-text h1 {
+  font-size: 20px;
+  font-weight: 700;
+  background: linear-gradient(135deg, #007aff, #5ac8fa);
+  -webkit-background-clip: text;
+  -webkit-text-fill-color: transparent;
+  background-clip: text;
+  margin: 0;
+}
+
+.title-text p {
+  font-size: 12px;
+  color: #6b7280;
+  font-weight: 400;
+  margin: 0;
+}
+
+.status-container {
+  margin-bottom: 24px;
+}
+
+.status {
+  font-size: 14px;
+  font-weight: 500;
+  padding: 12px 20px;
+  background: rgba(255, 255, 255, 0.08);
+  border-radius: 24px;
+  border: 1px solid rgba(255, 255, 255, 0.15);
+  backdrop-filter: blur(10px);
+  transition: all 0.3s ease;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  position: relative;
+}
+
+.duration {
+  margin-left: 8px;
+  font-size: 12px;
+  opacity: 0.8;
+  font-family:
+    "SF Mono", Monaco, "Cascadia Code", "Roboto Mono", Consolas, "Courier New",
+    monospace;
+}
+
+.status.recording {
+  background: rgba(255, 59, 48, 0.2);
+  border-color: rgba(255, 59, 48, 0.4);
+  animation: pulse 1.5s infinite;
+  box-shadow: 0 0 20px rgba(255, 59, 48, 0.3);
+}
+
+.status.processing {
+  background: rgba(255, 193, 7, 0.2);
+  border-color: rgba(255, 193, 7, 0.4);
+  animation: spin 1s linear infinite;
+}
+
+.status.success {
+  background: rgba(52, 199, 89, 0.2);
+  border-color: rgba(52, 199, 89, 0.4);
+}
+
+.status.error {
+  background: rgba(255, 59, 48, 0.2);
+  border-color: rgba(255, 59, 48, 0.4);
+}
+
+.status-icon {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: currentColor;
+}
+
+.status.recording .status-icon {
+  background: #ff3b30;
+  animation: pulse 1.5s infinite;
+}
+
+.status.processing .status-icon {
+  background: #ffc107;
+}
+
+@keyframes pulse {
+  0%,
+  100% {
+    opacity: 1;
+    transform: scale(1);
+  }
+
+  50% {
+    opacity: 0.6;
+    transform: scale(1.1);
+  }
+}
+
+@keyframes spin {
+  from {
+    transform: rotate(0deg);
+  }
+
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+@keyframes ripple {
+  0% {
+    transform: scale(1);
+    opacity: 1;
+  }
+  100% {
+    transform: scale(1.5);
+    opacity: 0;
+  }
+}
+
+@keyframes pulse {
+  0%,
+  100% {
+    opacity: 0.35;
+    transform: scale(1);
+  }
+  50% {
+    opacity: 0.5;
+    transform: scale(1.05);
+  }
+}
+
+@keyframes waveformPulse {
+  0%,
+  100% {
+    transform: scaleY(0.4);
+    opacity: 0.7;
+  }
+  50% {
+    transform: scaleY(1.2);
+    opacity: 1;
+  }
+}
+
+.controls {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  margin-bottom: 24px;
+}
+
+.button {
+  border: none;
+  color: white;
+  padding: 14px 24px;
+  border-radius: 12px;
+  cursor: pointer;
+  font-size: 14px;
+  font-weight: 500;
+  transition: all 0.3s ease;
+  backdrop-filter: blur(10px);
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  position: relative;
+  overflow: hidden;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+}
+
+.button.primary {
+  background: linear-gradient(
+    135deg,
+    rgba(0, 122, 255, 0.9) 0%,
+    rgba(0, 122, 255, 0.7) 100%
+  );
+}
+
+.button.secondary {
+  background: linear-gradient(
+    135deg,
+    rgba(0, 122, 255, 0.9) 0%,
+    rgba(0, 122, 255, 0.7) 100%
+  );
+}
+
+.icon {
+  font-size: 16px;
+}
+
+.recording-indicator {
+  width: 8px;
+  height: 8px;
+  background: #ff3b30;
+  border-radius: 50%;
+  animation: pulse 1.5s infinite;
+}
+
+.button::before {
+  content: "";
+  position: absolute;
+  top: 0;
+  left: -100%;
+  width: 100%;
+  height: 100%;
+  background: linear-gradient(
+    90deg,
+    transparent,
+    rgba(255, 255, 255, 0.2),
+    transparent
+  );
+  transition: left 0.5s;
+}
+
+.button:hover::before {
+  left: 100%;
+}
+
+.button:hover {
+  background: linear-gradient(
+    135deg,
+    rgba(0, 122, 255, 1) 0%,
+    rgba(0, 122, 255, 0.8) 100%
+  );
+  transform: translateY(-2px);
+  box-shadow: 0 8px 25px rgba(0, 122, 255, 0.3);
+}
+
+.button.secondary:hover {
+  background: linear-gradient(
+    135deg,
+    rgba(0, 122, 255, 1) 0%,
+    rgba(0, 122, 255, 0.8) 100%
+  );
+  transform: translateY(-2px);
+  box-shadow: 0 8px 25px rgba(0, 122, 255, 0.3);
+}
+
+.button:active {
+  transform: translateY(0);
+}
+
+.button:disabled {
+  background: rgba(255, 255, 255, 0.1);
+  cursor: not-allowed;
+  transform: none;
+  box-shadow: none;
+}
+
+.button.secondary:disabled {
+  background: linear-gradient(
+    135deg,
+    rgba(0, 122, 255, 0.6) 0%,
+    rgba(0, 122, 255, 0.4) 100%
+  );
+  opacity: 0.7;
+}
+
+.button:disabled::before {
+  display: none;
+}
+
+.button.recording {
+  background: linear-gradient(
+    135deg,
+    rgba(255, 59, 48, 0.9) 0%,
+    rgba(255, 59, 48, 0.7) 100%
+  );
+  animation: pulse 1.5s infinite;
+}
+
+.button.recording:hover {
+  background: linear-gradient(
+    135deg,
+    rgba(255, 59, 48, 1) 0%,
+    rgba(255, 59, 48, 0.8) 100%
+  );
+  box-shadow: 0 8px 25px rgba(255, 59, 48, 0.3);
+}
+
+.settings {
+  background: #ffffff;
+  border-radius: 0.75rem;
+  border: 1px solid #f3f4f6;
+  padding: 20px;
+  /* margin-bottom: 12px; */
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
+}
+
+.permission-section {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.permission-text {
+  font-size: 12px;
+  color: #6b7280;
+  text-align: center;
+  line-height: 1.4;
+  margin: 0;
+}
+
+.permission-message {
+  font-size: 11px;
+  color: #10b981;
+  text-align: center;
+  padding: 8px;
+  background: #ecfdf5;
+  border-radius: 6px;
+  border: 1px solid rgba(16, 185, 129, 0.2);
+  line-height: 1.4;
+}
+
+.settings h3 {
+  font-size: 16px;
+  font-weight: 600;
+  margin-bottom: 12px;
+  color: #111827;
+}
+
+.hotkey-display {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  font-size: 12px;
+  color: #6b7280;
+  margin-bottom: 8px;
+}
+
+.hotkey-combo {
+  background: #f3f4f6;
+  padding: 4px 8px;
+  border-radius: 6px;
+  font-family:
+    "SF Mono", Monaco, "Cascadia Code", "Roboto Mono", Consolas, "Courier New",
+    monospace;
+  font-size: 11px;
+  border: 1px solid #e5e7eb;
+  color: #111827;
+}
+
+.instructions {
+  font-size: 11px;
+  color: #9ca3af;
+  text-align: center;
+  line-height: 1.4;
+}
+
+.transcript-display {
+  margin-top: 16px;
+  padding: 16px;
+  background: #f9fafb;
+  border-radius: 12px;
+  border: 1px solid #f3f4f6;
