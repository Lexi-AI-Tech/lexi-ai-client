+
+.history-copy-btn:hover {
+  background: #f9fafb;
+  color: #111827;
+}
+
+/* Transcripts List Styles - fill remaining height and scroll inside (consistent with loading state) */
+.transcripts-list {
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  min-height: 0;
