@@ -0,0 +1,209 @@
+/* HotkeySelector - scoped to avoid clashes */
+.hotkey-selector {
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.hotkey-selector__header {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.hotkey-selector__label {
+  font-size: 11px;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.05em;
+  color: #9ca3af;
+}
+
+.hotkey-selector__description {
+  font-size: 12px;
+  color: #6b7280;
+  margin: 0;
+}
+
+.hotkey-selector__chips {
+  display: flex;
+  flex-direction: row;
+  flex-wrap: wrap;
+  gap: 12px;
+  align-items: center;
+}
+
+.hotkey-selector__chip-wrapper {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+}
+
+.hotkey-selector__chip {
+  background-color: #f9fafb;
+  padding: 12px 16px;
+  border-radius: 10px;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  border: 1px solid #e5e7eb;
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
+}
+
+.hotkey-selector__chip-wrapper:has(.hotkey-selector__remove-btn) .hotkey-selector__chip {
+  padding-right: 36px;
+}
+
+.hotkey-selector__remove-btn {
+  position: absolute;
+  top: 8px;
+  right: 8px;
+  width: 20px;
+  height: 20px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  background: transparent;
+  border: none;
+  border-radius: 4px;
+  color: #9ca3af;
+  cursor: pointer;
+  font-size: 14px;
+  line-height: 1;
+  font-weight: 600;
+  transition: all 0.2s ease;
+}
+
+.hotkey-selector__remove-btn:hover {
+  background: #fef2f2;
+  color: #ef4444;
+}
+
+.hotkey-selector__key-row {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.hotkey-selector__key-cap {
+  display: inline-flex;
+  flex-direction: column;
+  align-items: flex-start;
+  justify-content: space-between;
+  padding: 6px 8px;
+  min-width: 54px;
+  min-height: 48px;
+  background: linear-gradient(180deg, #3a3a3c 0%, #2c2c2e 100%);
+  color: #fff;
+  border-radius: 6px;
+  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
+  box-shadow: 0 1px 0 1px #1a1a1a, 0 2px 4px rgba(0, 0, 0, 0.3),
+    inset 0 1px 0 rgba(255, 255, 255, 0.1);
+  border: 1px solid #4a4a4c;
+  position: relative;
+}
+
+.hotkey-selector__key-symbol {
+  font-size: 13px;
+  position: absolute;
+  top: 8px;
+  right: 10px;
+  color: rgba(255, 255, 255, 0.9);
+}
+
+.hotkey-selector__key-label {
+  font-size: 10px;
+  font-weight: 400;
+  color: rgba(255, 255, 255, 0.85);
+  margin-top: auto;
+}
+
+.hotkey-selector__plus {
+  color: #9ca3af;
+  font-size: 14px;
+  font-weight: 400;
+  margin-left: 4px;
+}
+
+.hotkey-selector__recording {
+  background-color: #eff6ff;
+  padding: 12px 16px;
+  border-radius: 10px;
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  border: 2px solid rgba(59, 130, 246, 0.35);
+  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
+}
+
+.hotkey-selector__recording-placeholder {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 8px 0;
+}
+
+.hotkey-selector__recording-dot {
+  width: 8px;
+  height: 8px;
+  background: #3b82f6;
+  border-radius: 50%;
+  animation: hotkey-selector-pulse 1.5s infinite;
+}
+
+@keyframes hotkey-selector-pulse {
+  0%, 100% { opacity: 1; }
+  50% { opacity: 0.5; }
+}
+
+.hotkey-selector__recording-hint {
+  font-size: 13px;
+  color: #9ca3af;
+}
+
+.hotkey-selector__actions {
+  display: flex;
+  gap: 8px;
+}
+
+.hotkey-selector__btn {
+  padding: 8px 16px;
+  font-size: 13px;
+  font-weight: 500;
+  border-radius: 8px;
+  border: none;
+  transition: all 0.2s ease;
+  cursor: pointer;
+}
+
+.hotkey-selector__btn--primary {
+  background: #111827;
+  color: #ffffff;
+}
+
+.hotkey-selector__btn--primary:hover:not(:disabled) {
+  opacity: 0.9;
+}
+
+.hotkey-selector__btn--primary:disabled {
+  background: #f3f4f6;
+  color: #9ca3af;
+  cursor: not-allowed;
+  opacity: 0.5;
+}
+
+.hotkey-selector__btn--secondary {
+  background: #ffffff;
+  color: #111827;
+  border: 1px solid #e5e7eb;
+}
+
+.hotkey-selector__btn--secondary:hover {
+  background: #f9fafb;
+}
+
+.hotkey-selector__count {
+  font-size: 11px;
+  color: #9ca3af;
+}
