{
  "name": "lexi-ai",
  "version": "0.1.0",
  "description": "Speech-to-text overlay app for macOS",
  "author": "anadi45",
  "main": "src-tauri/src/main.rs",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build --features custom-protocol",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "format": "cd src-tauri && cargo fmt && cd .. && npx prettier --write .",
    "download-model": "bash scripts/download-model.sh",
    "setup": "bash scripts/setup.sh",
    "predev": "npm run setup",
    "prebuild": "npm run setup"
  },
  "dependencies": {
    "@choochmeque/tauri-plugin-google-auth-api": "^0.1.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.4.0"
  }
}
