{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexi AI",
  "version": "0.1.5",
  "identifier": "com.lexiai.client",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "Developer ID Application: Satyasai Vallampati (FWLCJN85BF)",
      "infoPlist": "Info.plist",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "background": "images/dmg-background.png"
      }
    }
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "",
        "width": 1360,
        "height": 900,
        "minWidth": 350,
        "minHeight": 400,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "decorations": true,
        "transparent": false,
        "url": "index.html",
        "devtools": false,
        "visible": true,
        "titleBarStyle": "Transparent"
      }
    ],
    "withGlobalTauri": false
  },
  "plugins": {
    "deep-link": {
      "schemes": ["lexi-ai"]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2ODlFRTZFRTYzMTQyRjgKUldUNFFqSG1idTZKTm1aVTEvbjRYL2ZjdWNoMU1lNEM3MFFOb3hXeFZpbzNISk1TSVlvL0trUTMK",
      "endpoints": [
        "https://server.speaklexi.com/api/v1/updates/latest?version={{current_version}}&target={{target}}"
      ]
    }
  }
}
