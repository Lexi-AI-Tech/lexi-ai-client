{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexi AI",
  "version": "0.1.0",
  "identifier": "com.lexi.ai",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "Apple Development: ranjeetbaraik15@gmail.com (Q7WQTDB93C)",
      "infoPlist": "Info.plist"
    }
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "Lexi AI",
        "width": 1200,
        "height": 750,
        "minWidth": 350,
        "minHeight": 400,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "decorations": true,
        "transparent": false,
        "url": "index.html",
        "devtools": true,
        "visible": true
      }
    ],
    "macOSPrivateApi": true,
    "withGlobalTauri": false
  },
  "plugins": {
    "deep-link": {
      "schemes": ["lexi-ai", "lexi"]
    }
  }
}
