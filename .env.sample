# Copy to `.env` and fill in.
# Only needed by maintainers building signed releases. Normal development
# (`npm run dev`) needs none of these.

# Tauri updater signing key (contents of the private key file, or its path)
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS signing and notarization (build:mac, publish:release)
APPLE_ID=
# App-specific password, not your Apple ID password
APPLE_PASSWORD=
APPLE_TEAM_ID=
# Certificate name as shown by `security find-identity -v -p codesigning`,
# e.g. "Developer ID Application: Your Name (TEAMID)"
APPLE_SIGNING_IDENTITY=

# Publishing releases (publish:release)
APP_RELEASES_API_KEY=
# Defaults to http://localhost:3000/api/v1/updates
API_URL=
